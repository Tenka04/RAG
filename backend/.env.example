# Assist Me - Environment Configuration Example
# Copy this file to backend/.env and update values

# Ollama Cloud or Custom Ollama Host
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_DEFAULT_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=all-minilm

# OpenRouter API Key (Supports DeepSeek V3, DeepSeek R1, etc.)
OPEN_ROUTER_KEY=your_openrouter_api_key_here

# Developer Mode Passcode
DEV_PASSCODE=dev123
